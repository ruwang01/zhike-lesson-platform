# 本地可使用 file:local.db；线上必须使用持久化 libSQL/Turso 数据库。
DATABASE_URL=
DATABASE_AUTH_TOKEN=
AUTH_BASE_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=
SESSION_SECRET=
# 仅首次初始化管理员时设置，完成后移除。
ADMIN_SETUP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 图片服务暂不启用；密钥留空。
IMAGE_API_KEY=

# 允许访问的其他网站来源，多个地址以英文逗号分隔。
APP_ALLOWED_ORIGINS=
